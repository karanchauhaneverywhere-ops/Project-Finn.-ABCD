rules_version = '2';

// Each signed-in user can only read/write their own data, stored at
// users/{their-uid}/data/{quiz|routine}. Nobody can read or write another
// user's documents, and unauthenticated access is denied entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
