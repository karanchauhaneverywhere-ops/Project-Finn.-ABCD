//@version=6

// =============================================================================
// Path Geometry Trend Detector
// -----------------------------------------------------------------------------
// Classifies the market as Strong Uptrend / Uptrend / Sideways-Range /
// Downtrend / Strong Downtrend by measuring the GEOMETRY OF THE PRICE PATH.
//
// The premise: a trend is a path that covers ground efficiently in one
// direction. A range is a path that travels just as far but arrives nowhere.
// That distinction is measurable directly, without fitting a line to price or
// smoothing it first.
//
// Four components, each producing a number in [-1, +1]:
//
//   1. Signed Efficiency Ratio  net displacement / total path length
//   2. Breakout structure       N-bar channel breaks, held until reversed
//   3. Range position           where price sits inside its own recent range
//   4. Displacement balance     (up closes - down closes) / window
//
// They are combined by weighted average into a Trend Score of -100..+100,
// which drives a sticky state machine with hysteresis.
//
// Notable properties:
//   - No moving averages, anywhere. Nothing to warm up for 200 bars; the
//     longest default lookback is 40, so it works on short histories.
//   - No smoothing, so no smoothing lag.
//   - Breakout structure confirms on the breaking bar itself, unlike swing
//     pivots, which cannot confirm until N later bars have closed.
//   - Every component is normalized to the same [-1, +1] range, so the
//     weights mean what they say and the score is directly comparable across
//     instruments and timeframes.
//
// Every formula is a closed-form arithmetic expression: differences, sums,
// absolute values, ratios, counts, min/max. Nothing here is a probability, a
// statistical inference (p-value, confidence interval, Bayesian posterior) or
// a machine-learning likelihood.
//
// The chart also draws the trade lifecycle — entry markers on the qualifying
// edge, a ratcheting ATR stop, exit markers — because a shaded background is a
// STATE that lasts for many bars, while an entry is a single bar. Reading an
// entry off the shading means buying the same trend far later, at a worse
// price, with no stop.
//
// This script is for research/education. It is not financial advice.
// =============================================================================
indicator("Path Geometry Trend Detector [Finn]", shorttitle = "PGT", overlay = true)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpEngine = "Path Geometry Engine"
erLen  = input.int(20, "Efficiency Ratio length", minval = 2, group = grpEngine)
donLen = input.int(20, "Breakout channel length", minval = 2, group = grpEngine)
posLen = input.int(20, "Range-position length", minval = 2, group = grpEngine)
balLen = input.int(20, "Displacement balance length", minval = 2, group = grpEngine)

grpWeights = "Component Weights"
wER     = input.float(1.0, "Efficiency Ratio", minval = 0.0, step = 0.1, group = grpWeights)
wStruct = input.float(1.0, "Breakout structure", minval = 0.0, step = 0.1, group = grpWeights)
wPos    = input.float(1.0, "Range position", minval = 0.0, step = 0.1, group = grpWeights)
wBal    = input.float(1.0, "Displacement balance", minval = 0.0, step = 0.1, group = grpWeights)

grpGate = "Compression Gate"
useGate = input.bool(true, "Block NEW trend calls while the range is compressing", group = grpGate)
expLen  = input.int(20, "Range-expansion window", minval = 2, group = grpGate)
expMin  = input.float(0.80, "Expansion ratio below this counts as compressing", minval = 0.1, step = 0.05, group = grpGate)

grpClass = "Classification"
enterThresh    = input.int(40, "|Score| >= this => trend (entry threshold)", minval = 1, maxval = 100, group = grpClass)
strongThresh   = input.int(70, "|Score| >= this => strong trend", minval = 1, maxval = 100, group = grpClass)
exitThresh     = input.int(15, "Leave a trend when |score| drops below this (must be < entry threshold)", minval = 0, maxval = 100, group = grpClass)
confirmOnClose = input.bool(true, "Only update the state on closed bars (prevents intrabar flicker)", group = grpClass)

grpTrade = "Trade Overlay"
showTrades  = input.bool(true, "Mark entries, exits and the trailing stop", group = grpTrade)
allowLong   = input.bool(true, "Mark long entries", group = grpTrade)
allowShort  = input.bool(true, "Mark short entries", group = grpTrade)
atrLen      = input.int(14, "ATR length (stop distance)", minval = 1, group = grpTrade)
atrStopMult = input.float(2.5, "Initial risk & chandelier trail, in ATRs", minval = 0.5, step = 0.5, group = grpTrade)

grpDisp = "Display"
showTable   = input.bool(true, "Show breakdown table", group = grpDisp)
showBg      = input.bool(true, "Shade background by trend", group = grpDisp)
showChannel = input.bool(true, "Draw the breakout channel", group = grpDisp)

// -----------------------------------------------------------------------------
// Input validation
// -----------------------------------------------------------------------------
// These combinations are silently destructive rather than merely suboptimal,
// so they fail loudly instead of producing plausible-looking nonsense.
if exitThresh >= enterThresh
    runtime.error("Exit threshold (" + str.tostring(exitThresh) + ") must be BELOW the entry threshold (" + str.tostring(enterThresh) + "). Without a gap there is no hysteresis: the state flips on alternating bars.")
if enterThresh > strongThresh
    runtime.error("Entry threshold (" + str.tostring(enterThresh) + ") must not exceed the strong-trend threshold (" + str.tostring(strongThresh) + "), or every trend is labelled 'Strong'.")
if wER + wStruct + wPos + wBal <= 0
    runtime.error("At least one component weight must be greater than zero.")

// -----------------------------------------------------------------------------
// 1. Signed Efficiency Ratio — net displacement over total path length
// -----------------------------------------------------------------------------
// Walk erLen bars. Sum every step you took (path length), then compare that to
// how far you actually ended up from where you started (net displacement).
// Straight line up  -> displacement == path      -> +1
// Straight line down                             -> -1
// Thrashing that returns to start -> displacement 0 -> 0
//
// One number carrying both direction and straightness, with no line fit.
netMove = close - close[erLen]
pathLen = math.sum(math.abs(close - close[1]), erLen)
erRaw   = pathLen > 0 ? netMove / pathLen : na
er      = na(erRaw) ? 0.0 : math.max(-1.0, math.min(1.0, erRaw))

// -----------------------------------------------------------------------------
// 2. Breakout structure — channel breaks, held until reversed
// -----------------------------------------------------------------------------
// The [1] matters: without it the current bar is inside its own channel, so
// `high > highest(high, donLen)` could never be true. Comparing against the
// channel as of the PREVIOUS bar is what makes a break detectable.
//
// Unlike swing pivots, this confirms on the breaking bar itself — no waiting
// N bars for a pivot to be validated. The state then persists until the
// opposite band breaks, which is the classical Donchian/Turtle definition.
upperBand = ta.highest(high, donLen)[1]
lowerBand = ta.lowest(low, donLen)[1]

var int structState = 0
if not na(upperBand) and high > upperBand
    structState := 1
else if not na(lowerBand) and low < lowerBand
    structState := -1

// -----------------------------------------------------------------------------
// 3. Range position — where price sits inside its own recent range
// -----------------------------------------------------------------------------
// Measured from the midpoint and scaled by the half-range, so the top of the
// range is +1, the bottom -1, the middle 0. Carries directional bias with no
// averaging and therefore no averaging lag.
rngHigh  = ta.highest(high, posLen)
rngLow   = ta.lowest(low, posLen)
rngSize  = rngHigh - rngLow
posRaw   = rngSize > 0 ? (close - (rngHigh + rngLow) / 2) / (rngSize / 2) : na
rangePos = na(posRaw) ? 0.0 : math.max(-1.0, math.min(1.0, posRaw))

// -----------------------------------------------------------------------------
// 4. Displacement balance — a count, nothing more
// -----------------------------------------------------------------------------
// Of the last balLen bars, how many closed up versus down? All up gives +1,
// all down -1, an even split 0. Deliberately crude: it ignores the size of
// each move and so cannot be dominated by one outsized bar the way an
// average can.
upBars   = math.sum(close > close[1] ? 1.0 : 0.0, balLen)
downBars = math.sum(close < close[1] ? 1.0 : 0.0, balLen)
balRaw   = (upBars - downBars) / balLen
balance  = na(balRaw) ? 0.0 : balRaw

// -----------------------------------------------------------------------------
// Compression gate — is the range expanding or coiling?
// -----------------------------------------------------------------------------
// Compare the range covered over the last expLen bars against the range
// covered over the expLen bars before that. Below 1 means the market is
// covering less ground than it was: coiling, not travelling. This gates NEW
// trend calls only — it never cancels an established one, because a pullback
// inside a real trend compresses the range too.
rangeNow    = ta.highest(high, expLen) - ta.lowest(low, expLen)
rangePast   = ta.highest(high, expLen)[expLen] - ta.lowest(low, expLen)[expLen]
expRatio    = rangePast > 0 ? rangeNow / rangePast : na
compressing = useGate and not na(expRatio) and expRatio < expMin

// -----------------------------------------------------------------------------
// Composite Trend Score, -100 .. +100
// -----------------------------------------------------------------------------
// Every component is already normalized to [-1, +1], so this is a plain
// weighted average scaled to 100 — the weights mean exactly what they say.
// Each component falls back to 0 when its inputs aren't ready, so a component
// that isn't warm contributes nothing rather than nullifying the sum.
wSum       = wER + wStruct + wPos + wBal
scoreRaw   = 100.0 * (wER * er + wStruct * structState + wPos * rangePos + wBal * balance) / wSum
trendScore = math.max(-100.0, math.min(100.0, scoreRaw))

// -----------------------------------------------------------------------------
// Classification — sticky state machine with hysteresis
// -----------------------------------------------------------------------------
// Entering a trend needs |score| >= enterThresh; leaving needs it to fall
// below the looser exitThresh. The gap between them is a dead zone that stops
// noise around one boundary from flipping the label on adjacent bars.
//
// mayUpdate holds the state still until the bar closes, so a label or alert
// cannot appear mid-bar and then vanish before the bar completes.
var string trendState = "Sideways / Range"

mayUpdate = not confirmOnClose or barstate.isconfirmed

if mayUpdate
    bool inUp   = trendState == "Uptrend" or trendState == "Strong Uptrend"
    bool inDown = trendState == "Downtrend" or trendState == "Strong Downtrend"
    if inUp
        // Full reversal is checked first: it also satisfies the exit test.
        if trendScore <= -enterThresh
            trendState := trendScore <= -strongThresh ? "Strong Downtrend" : "Downtrend"
        else if trendScore < exitThresh
            trendState := "Sideways / Range"
        else
            trendState := trendScore >= strongThresh ? "Strong Uptrend" : "Uptrend"
    else if inDown
        if trendScore >= enterThresh
            trendState := trendScore >= strongThresh ? "Strong Uptrend" : "Uptrend"
        else if trendScore > -exitThresh
            trendState := "Sideways / Range"
        else
            trendState := trendScore <= -strongThresh ? "Strong Downtrend" : "Downtrend"
    else if not compressing
        if trendScore >= enterThresh
            trendState := trendScore >= strongThresh ? "Strong Uptrend" : "Uptrend"
        else if trendScore <= -enterThresh
            trendState := trendScore <= -strongThresh ? "Strong Downtrend" : "Downtrend"

var int barsInState = 0
barsInState := (trendState == trendState[1]) ? barsInState + 1 : 0

// -----------------------------------------------------------------------------
// Trade overlay
// -----------------------------------------------------------------------------
// The background answers "what state is the market in?". These answer "what
// would a system trading this actually have done?" — which is the question
// that matters before taking a position. The state is true for a whole run of
// bars; the entry is true for exactly one.
atrVal = ta.atr(atrLen)

longQualifies  = allowLong  and not compressing and trendScore >= enterThresh
shortQualifies = allowShort and not compressing and trendScore <= -enterThresh

// The rising edge is the entry: it fires on a fresh score cross into
// qualifying territory, or on compression clearing while the score already
// qualifies — either way, once.
longEntrySignal  = longQualifies  and not longQualifies[1]
shortEntrySignal = shortQualifies and not shortQualifies[1]

var int   simPos         = 0        // 0 flat, +1 long, -1 short
var float simEntry       = na
var float longStopLevel  = na
var float shortStopLevel = na

bool wentLong       = false
bool wentShort      = false
bool stopHit        = false
bool scoreExit      = false
float exitMarkPrice = na

// 1. The stop set on the previous close is live during this bar and fills
//    intrabar. `high`/`low` only widen as a bar forms, so once this test is
//    true it cannot flicker back off.
if simPos == 1 and not na(longStopLevel) and low <= longStopLevel
    stopHit := true
    exitMarkPrice := longStopLevel
    simPos := 0
    simEntry := na
else if simPos == -1 and not na(shortStopLevel) and high >= shortStopLevel
    stopHit := true
    exitMarkPrice := shortStopLevel
    simPos := 0
    simEntry := na

// 2. Score exits, entries and the ratchet all key off trendScore, which moves
//    while a bar is forming, so they wait for the close.
if mayUpdate
    if simPos == 1 and trendScore < exitThresh
        scoreExit := true
        exitMarkPrice := close
        simPos := 0
        simEntry := na
    else if simPos == -1 and trendScore > -exitThresh
        scoreExit := true
        exitMarkPrice := close
        simPos := 0
        simEntry := na

    // A signal in the direction already held is ignored; a signal against an
    // open position reverses it. The simPos guard also stops a re-fire from
    // re-seeding — and so loosening — a stop that has already ratcheted.
    if longEntrySignal and simPos <= 0
        wentLong := true
        simPos := 1
        simEntry := close
        longStopLevel := high - atrStopMult * atrVal
    else if shortEntrySignal and simPos >= 0
        wentShort := true
        simPos := -1
        simEntry := close
        shortStopLevel := low + atrStopMult * atrVal

    // Ratchet for the next bar — tightens only, never loosens.
    if simPos == 1 and not wentLong
        longStopLevel := math.max(longStopLevel, high - atrStopMult * atrVal)
    if simPos == -1 and not wentShort
        shortStopLevel := math.min(shortStopLevel, low + atrStopMult * atrVal)

activeStop = simPos == 1 ? longStopLevel : (simPos == -1 ? shortStopLevel : na)

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
plot(showChannel ? upperBand : na, title = "Breakout channel high", color = color.new(color.teal, 40))
plot(showChannel ? lowerBand : na, title = "Breakout channel low", color = color.new(color.teal, 40))

bgColor = trendState == "Strong Uptrend" ? color.new(color.green, 75) :
     trendState == "Uptrend" ? color.new(color.green, 88) :
     trendState == "Strong Downtrend" ? color.new(color.red, 75) :
     trendState == "Downtrend" ? color.new(color.red, 88) :
     color.new(color.gray, 90)

bgcolor(showBg ? bgColor : na)

plot(showTrades and simPos == 1 ? longStopLevel : na, title = "Chandelier stop (long)", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(showTrades and simPos == -1 ? shortStopLevel : na, title = "Chandelier stop (short)", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)

plotshape(showTrades and wentLong ? low : na, title = "Long entry", style = shape.labelup, location = location.belowbar, color = color.new(color.lime, 0), textcolor = color.black, text = "LONG", size = size.small)
plotshape(showTrades and wentShort ? high : na, title = "Short entry", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, text = "SHORT", size = size.small)
plotshape(showTrades and stopHit ? exitMarkPrice : na, title = "Stop hit", style = shape.xcross, location = location.absolute, color = color.new(color.orange, 0), size = size.small)
plotshape(showTrades and scoreExit ? exitMarkPrice : na, title = "Score exit", style = shape.square, location = location.absolute, color = color.new(color.silver, 0), size = size.tiny)

// Numeric detail, kept off the chart and available in the Data Window
plot(trendScore, "Trend score", display = display.data_window)
plot(er, "Efficiency ratio", display = display.data_window)
plot(structState, "Breakout structure", display = display.data_window)
plot(rangePos, "Range position", display = display.data_window)
plot(balance, "Displacement balance", display = display.data_window)
plot(expRatio, "Range expansion", display = display.data_window)

// -----------------------------------------------------------------------------
// Breakdown table
// -----------------------------------------------------------------------------
var table infoTable = table.new(position.top_right, 2, 11, border_width = 1)

f_cell(t, row, label, value, valColor) =>
    table.cell(t, 0, row, label, text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(t, 1, row, value, text_color = valColor, bgcolor = color.new(color.black, 30), text_size = size.small)

f_bias(v) =>
    v > 0.05 ? color.lime : (v < -0.05 ? color.red : color.silver)

if showTable and barstate.islast
    stateColor = (trendState == "Strong Uptrend" or trendState == "Uptrend") ? color.lime :
         (trendState == "Strong Downtrend" or trendState == "Downtrend") ? color.red : color.silver
    f_cell(infoTable, 0, "Trend State", trendState, stateColor)
    f_cell(infoTable, 1, "Trend Score", str.tostring(trendScore, "#.0") + " / 100", stateColor)
    f_cell(infoTable, 2, "Efficiency ratio", str.tostring(er, "#.##"), f_bias(er))
    f_cell(infoTable, 3, "Breakout structure", structState == 1 ? "Broken up" : (structState == -1 ? "Broken down" : "None yet"), f_bias(structState))
    f_cell(infoTable, 4, "Range position", str.tostring(rangePos, "#.##"), f_bias(rangePos))
    f_cell(infoTable, 5, "Displacement balance", str.tostring(balance, "#.##"), f_bias(balance))
    f_cell(infoTable, 6, "Range expansion", na(expRatio) ? "n/a" : str.tostring(expRatio, "#.##"), compressing ? color.orange : color.white)
    f_cell(infoTable, 7, "New entries", compressing ? "Blocked (compressing)" : "Clear", compressing ? color.orange : color.lime)
    f_cell(infoTable, 8, "Bars in state", str.tostring(barsInState), color.white)
    posText = simPos == 1 ? "Long from " + str.tostring(simEntry, format.mintick) :
         simPos == -1 ? "Short from " + str.tostring(simEntry, format.mintick) : "Flat"
    f_cell(infoTable, 9, "Position", posText, simPos == 1 ? color.lime : (simPos == -1 ? color.red : color.silver))
    f_cell(infoTable, 10, "Active stop", na(activeStop) ? "—" : str.tostring(activeStop, format.mintick), na(activeStop) ? color.silver : color.orange)

// -----------------------------------------------------------------------------
// Alerts
// -----------------------------------------------------------------------------
// Direction-level edges, so an Uptrend -> Strong Uptrend upgrade does not
// re-fire "entered an uptrend" — that is a strength change, not a regime one.
isUp   = trendState == "Uptrend" or trendState == "Strong Uptrend"
isDown = trendState == "Downtrend" or trendState == "Strong Downtrend"
isFlat = trendState == "Sideways / Range"

alertcondition(isUp and not isUp[1], title = "Entered Uptrend", message = "Path Geometry: {{ticker}} entered an UPTREND on {{interval}}")
alertcondition(isDown and not isDown[1], title = "Entered Downtrend", message = "Path Geometry: {{ticker}} entered a DOWNTREND on {{interval}}")
alertcondition(isFlat and not isFlat[1], title = "Entered Sideways", message = "Path Geometry: {{ticker}} entered SIDEWAYS/RANGE on {{interval}}")

// Trade-level alerts. These are the ones to act on: the three above describe
// market conditions, these four describe trades.
alertcondition(wentLong, title = "TRADE: long entry", message = "Path Geometry: LONG entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(wentShort, title = "TRADE: short entry", message = "Path Geometry: SHORT entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(stopHit, title = "TRADE: stop hit", message = "Path Geometry: trailing stop hit on {{ticker}} {{interval}}")
alertcondition(scoreExit, title = "TRADE: score exit", message = "Path Geometry: score exit on {{ticker}} {{interval}} at {{close}}")
