//@version=6
// =============================================================================
//  FINN · ABCD  ▸  UNIVERSAL REGIME ENGINE — STRATEGY   (FURE-S)
// -----------------------------------------------------------------------------
//  This is the executable twin of "Universal Regime Engine [Finn]". The entire
//  measurement engine — the seven ATR/percentile-normalised factors, the score,
//  the regime classifier and the three playbooks — is byte-for-byte the same
//  code as the indicator, so what you see on the chart is exactly what is being
//  traded here. Only the part after the engine differs: order execution,
//  position sizing, scale-outs and trailing.
//
//  WHY IT PORTS ACROSS MARKETS AND TIMEFRAMES
//  ------------------------------------------
//  Same reason as the indicator: nothing is measured in the instrument's own
//  price units. Position size is derived from the distance to the stop, so the
//  same "risk 1%" setting produces a sane size on a 5-digit FX pair, on a
//  6-figure crypto pair and on a 3-digit index future without being retuned.
//
//  HONEST BACKTESTING NOTES — read these before you trust any equity curve
//  -----------------------------------------------------------------------
//   * Orders fill on the NEXT bar's open (TradingView's default). There is no
//     process_orders_on_close shortcut here, because filling at the close of the
//     very bar that produced the signal flatters results.
//   * calc_on_every_tick is off and signals are closed-bar by default, so the
//     backtest and the live chart agree.
//   * Commission (0.03%) and 1-tick slippage are on by DEFAULT. Turn them up for
//     illiquid symbols. A strategy that only works at zero cost does not work.
//   * Scale-outs use qty_percent, which is a percent of the position remaining
//     at that moment: 33% then 50% of the rest then the remainder ≈ three equal
//     thirds. Intrabar fill order between stop and target is unknowable from
//     bar data, so multi-target results on high timeframes are approximations.
//   * There is no optimisation loop, no walk-forward and no curve-fit default.
//     The defaults are round numbers chosen because they are standard, not
//     because they maximised a past P&L.
//
//  This is a research / decision-support tool. It is not financial advice.
// =============================================================================

strategy("Universal Regime Engine Strategy [Finn]", shorttitle = "FURE-S", overlay = true,
     initial_capital        = 10000,
     default_qty_type       = strategy.fixed,
     default_qty_value      = 1,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.03,
     slippage               = 1,
     pyramiding             = 0,
     calc_on_every_tick     = false,
     max_labels_count       = 500,
     max_lines_count        = 500)

// >>>>> ENGINE BLOCK START — must stay byte-identical in indicator and strategy >>>>>
// -----------------------------------------------------------------------------
// 0 · INPUTS
// -----------------------------------------------------------------------------
grpCore = "① Engine core"
src        = input.source(close, "Source", group = grpCore)
atrLen     = input.int(14, "ATR length (the universal ruler)", minval = 2, group = grpCore, tooltip = "Every distance in this script is divided by this ATR. It is what makes one setting work on a 5-digit FX pair and on a 6-figure crypto pair.")
erLen      = input.int(20, "Adaptive MA · efficiency window", minval = 2, group = grpCore)
kFast      = input.int(2,  "Adaptive MA · fast constant", minval = 1, group = grpCore)
kSlow      = input.int(30, "Adaptive MA · slow constant", minval = 2, group = grpCore)
slopeLen   = input.int(5,  "Slope lookback (bars)", minval = 1, group = grpCore)
slopeNorm  = input.float(0.75, "Full slope score at (ATR over lookback)", minval = 0.05, step = 0.05, group = grpCore)
distNorm   = input.float(2.0,  "Full displacement score at (ATR)", minval = 0.1, step = 0.1, group = grpCore)
stretchMax = input.float(3.0,  "Over-extension guard (ATR)", minval = 0.5, step = 0.25, group = grpCore)
rsiLen     = input.int(14, "RSI length", minval = 2, group = grpCore)
mfiLen     = input.int(14, "MFI length", minval = 2, group = grpCore)
smoothLen  = input.int(2,  "Score smoothing (EMA bars)", minval = 1, maxval = 50, group = grpCore)

grpW = "② Factor weights  ·  set 0 to disable a factor entirely"
wTrend  = input.float(1.5,  "1 · Trend slope",          minval = 0, maxval = 5, step = 0.1, group = grpW)
wDist   = input.float(1.0,  "2 · Displacement vs MA",   minval = 0, maxval = 5, step = 0.1, group = grpW)
wMom    = input.float(1.0,  "3 · Momentum (RSI)",       minval = 0, maxval = 5, step = 0.1, group = grpW)
wAdx    = input.float(1.0,  "4 · Directional strength", minval = 0, maxval = 5, step = 0.1, group = grpW)
wStruct = input.float(1.5,  "5 · Market structure",     minval = 0, maxval = 5, step = 0.1, group = grpW)
wFlow   = input.float(0.75, "6 · Volume flow (MFI)",    minval = 0, maxval = 5, step = 0.1, group = grpW)
wHtf    = input.float(1.25, "7 · Higher-timeframe bias",minval = 0, maxval = 5, step = 0.1, group = grpW)

grpReg = "③ Regime classifier"
diLen       = input.int(14, "DI length", minval = 2, group = grpReg)
adxSm       = input.int(14, "ADX smoothing", minval = 1, group = grpReg)
adxFloor    = input.float(20.0, "ADX trend floor", minval = 5, maxval = 60, step = 1, group = grpReg)
adxFull     = input.float(40.0, "ADX at full conviction", minval = 15, maxval = 80, step = 1, group = grpReg)
sqzLen      = input.int(20, "Squeeze length", minval = 5, group = grpReg)
bbMult      = input.float(2.0, "Bollinger multiple", minval = 0.5, step = 0.1, group = grpReg)
kcMult      = input.float(1.5, "Keltner multiple", minval = 0.5, step = 0.1, group = grpReg)
volRankLen  = input.int(100, "Volatility percentile window", minval = 20, group = grpReg)
volHot      = input.float(80.0, "Volatile-range percentile", minval = 50, maxval = 100, step = 1, group = grpReg)
pvtLen      = input.int(5, "Swing pivot strength (bars each side)", minval = 1, group = grpReg)
structMem   = input.int(50, "Structure memory / decay (bars)", minval = 5, group = grpReg)

grpHtf = "④ Higher-timeframe context"
htfMode   = input.string("Auto (chart × N)", "HTF mode", options = ["Auto (chart × N)", "Manual", "Off"], group = grpHtf)
htfMult   = input.int(4, "Auto multiple", minval = 2, maxval = 24, group = grpHtf, tooltip = "4 is the classic ratio: 5m→20m, 1H→4H, 1D→4D. Derived from the chart, so it scales with whatever timeframe you open.")
htfManual = input.timeframe("240", "Manual timeframe", group = grpHtf)
htfStrict = input.bool(true, "Use last CLOSED HTF bar (non-repainting)", group = grpHtf)

grpSig = "⑤ Signal engine"
sigMode   = input.string("Auto (regime aware)", "Playbook", options = ["Auto (regime aware)", "Trend-following only", "Mean-reversion only", "Breakout only"], group = grpSig)
entryTh   = input.float(35.0, "Entry |score| threshold", minval = 5, maxval = 95, step = 1, group = grpSig)
exitTh    = input.float(10.0, "Flat / stand-aside |score|", minval = 0, maxval = 90, step = 1, group = grpSig)
mrStretch = input.float(1.0, "Reversion needs prior stretch (ATR)", minval = 0, step = 0.25, group = grpSig, tooltip = "How far price must have been pushed away from its adaptive mean, within the lookback below, before a fade is allowed. Set to 0 to remove the requirement entirely — the reversion playbook then fires on any threshold cross.")
mrLook    = input.int(5, "Reversion stretch lookback (bars)", minval = 1, group = grpSig)
needStruct= input.bool(true, "Require market-structure agreement", group = grpSig)
needHtf   = input.bool(true, "Require higher-timeframe agreement", group = grpSig)
cooldown  = input.int(5, "Cooldown between signals (bars)", minval = 0, group = grpSig)
closedOnly= input.bool(true, "Only evaluate on closed bars", group = grpSig)
entryMode = input.string("Confirm — break of the signal bar's extreme", "Entry trigger", options = ["Confirm — break of the signal bar's extreme", "Immediate — act on the signal bar"], group = grpSig, tooltip = "A signal means the evidence has lined up. It does not mean 'buy here'. Confirm mode only ARMS the setup at the signal bar's high (long) or low (short); the entry moment is the bar where price actually takes that level out. Signals price never confirms simply lapse.")
armExpiry = input.int(5, "Armed setup expires after (bars)", minval = 1, group = grpSig, tooltip = "If price has not taken out the armed level within this many bars, the setup lapses untriggered.")

grpRisk = "⑥ Risk model"
stopMode = input.string("Structure + ATR buffer", "Stop placement", options = ["Structure + ATR buffer", "Pure ATR", "Chandelier"], group = grpRisk)
atrStop  = input.float(1.5, "ATR multiple", minval = 0.2, step = 0.1, group = grpRisk)
swingLB  = input.int(10, "Structure lookback for the stop (bars)", minval = 2, group = grpRisk)
rt1      = input.float(1.0, "Target 1 (R)", minval = 0.25, step = 0.25, group = grpRisk)
rt2      = input.float(2.0, "Target 2 (R)", minval = 0.25, step = 0.25, group = grpRisk)
rt3      = input.float(3.0, "Target 3 (R)", minval = 0.25, step = 0.25, group = grpRisk)
riskPct  = input.float(1.0, "Risk per trade %", minval = 0.01, step = 0.05, group = grpRisk)

// -----------------------------------------------------------------------------
// 1 · HELPERS
// -----------------------------------------------------------------------------
f_clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

// Kaufman Adaptive Moving Average.
// efficiency ratio = |net move| / |sum of absolute moves|  ->  0 = pure noise,
// 1 = a perfectly straight line. The smoothing constant is interpolated between
// the fast and slow EMA constants by that ratio, then squared.
f_kama(source, erWin, fastN, slowN) =>
    float step   = math.abs(source - nz(source[1], source))
    float noise  = math.sum(step, erWin)
    float signal = math.abs(source - nz(source[erWin], source))
    float er     = noise > 0 ? signal / noise : 0.0
    float fsc    = 2.0 / (fastN + 1.0)
    float ssc    = 2.0 / (slowN + 1.0)
    float sc     = math.pow(er * (fsc - ssc) + ssc, 2.0)
    var float out = na
    out := na(out) ? source : out + sc * (source - out)
    out

// Text gauge for the panel: -1 .. +1  ->  "◄███··" / "►███··"
f_gauge(v) =>
    float c = f_clamp(v, -1.0, 1.0)
    float n = math.abs(c) * 5.0
    string s = ""
    for i = 1 to 5
        s := s + (i <= n + 0.5 ? "█" : "·")
    (c < -0.02 ? "◄ " : c > 0.02 ? "► " : "· ") + s

// The slope+displacement core, isolated so the SAME maths can be evaluated in a
// higher-timeframe context by request.security.
f_biasCore() =>
    float k  = f_kama(src, erLen, kFast, kSlow)
    float a  = ta.atr(atrLen)
    float sl = a > 0 ? (k - k[slopeLen]) / a : 0.0
    float ds = a > 0 ? (src - k) / a : 0.0
    0.6 * f_clamp(sl / slopeNorm, -1.0, 1.0) + 0.4 * f_clamp(ds / distNorm, -1.0, 1.0)

f_htfPacket(sh) =>
    float b = f_biasCore()
    b[sh]

// -----------------------------------------------------------------------------
// 2 · VOLATILITY BASE  (the ruler everything else is measured against)
// -----------------------------------------------------------------------------
float atr    = ta.atr(atrLen)
float atrPct = close != 0 ? atr / close * 100.0 : 0.0
float volPct = ta.percentrank(atr, volRankLen)

// -----------------------------------------------------------------------------
// 3 · FACTOR 1 & 2 — adaptive trend slope and displacement
// -----------------------------------------------------------------------------
float kama     = f_kama(src, erLen, kFast, kSlow)
float slopeATR = atr > 0 ? (kama - kama[slopeLen]) / atr : 0.0
float distATR  = atr > 0 ? (src - kama) / atr : 0.0
float sTrend   = f_clamp(slopeATR / slopeNorm, -1.0, 1.0)
float sDist    = f_clamp(distATR / distNorm, -1.0, 1.0)

// -----------------------------------------------------------------------------
// 4 · FACTOR 3 — momentum
// -----------------------------------------------------------------------------
float rsi  = ta.rsi(src, rsiLen)
float sMom = f_clamp((nz(rsi, 50.0) - 50.0) / 25.0, -1.0, 1.0)

// -----------------------------------------------------------------------------
// 5 · FACTOR 4 — directional strength (direction × conviction, kept separate)
// -----------------------------------------------------------------------------
[diPlus, diMinus, adxVal] = ta.dmi(diLen, adxSm)
float diBal  = (diPlus + diMinus) > 0 ? (diPlus - diMinus) / (diPlus + diMinus) : 0.0
float adxMag = f_clamp(nz(adxVal) / adxFull, 0.0, 1.0)
float sAdx   = f_clamp(diBal, -1.0, 1.0) * adxMag

// -----------------------------------------------------------------------------
// 6 · FACTOR 5 — market structure (BOS / CHoCH) from confirmed pivots
//     A pivot confirms `pvtLen` bars after it prints; the state therefore
//     updates LATE, never early. That lag is disclosed, not hidden.
// -----------------------------------------------------------------------------
float ph = ta.pivothigh(high, pvtLen, pvtLen)
float pl = ta.pivotlow(low, pvtLen, pvtLen)

var float lastPH   = na
var float lastPL   = na
var int   lastPHbar = na
var int   lastPLbar = na
var bool  phLive   = false
var bool  plLive   = false
var int   structDir = 0
var int   structBar = na
var float structLvl = na

if not na(ph)
    lastPH    := ph
    lastPHbar := bar_index - pvtLen
    phLive    := true
if not na(pl)
    lastPL    := pl
    lastPLbar := bar_index - pvtLen
    plLive    := true

bool rawBosUp = phLive and not na(lastPH) and close > lastPH
bool rawBosDn = plLive and not na(lastPL) and close < lastPL
// An outside bar can break both sides at once — resolve by where it closed.
bool bosUp = rawBosUp and (not rawBosDn or close >= open)
bool bosDn = rawBosDn and (not rawBosUp or close <  open)

bool chochUp = bosUp and structDir <= 0
bool chochDn = bosDn and structDir >= 0

if bosUp
    phLive    := false
    structDir := 1
    structBar := bar_index
    structLvl := lastPH
if bosDn
    plLive    := false
    structDir := -1
    structBar := bar_index
    structLvl := lastPL

// The fade runs linearly to zero over structMem bars and the state then EXPIRES:
// both the score contribution and the directional gate return to neutral. Without
// the expiry, "memory" was a misnomer — a break 3000 bars old still biased the
// score and still blocked one side of every entry.
float structAge    = na(structBar) ? na : (bar_index - structBar) * 1.0
bool  structLive   = not na(structAge) and structAge <= structMem
float structFade   = structLive ? f_clamp(1.0 - structAge / (structMem * 1.0), 0.0, 1.0) : 0.0
int   structEff    = structLive ? structDir : 0
float sStruct      = structEff * structFade

// -----------------------------------------------------------------------------
// 7 · FACTOR 6 — volume flow, with graceful degradation
//     Many FX / index / CFD feeds report no volume at all. Rather than feeding
//     the blend a fake zero, the factor is dropped and its weight is removed
//     from the denominator so the -100..+100 scale is preserved.
// -----------------------------------------------------------------------------
float volAvg   = ta.sma(nz(volume), 20)
bool  volUsable = volAvg > 0
float mfi      = ta.mfi(hlc3, mfiLen)
float sFlow    = volUsable ? f_clamp((nz(mfi, 50.0) - 50.0) / 25.0, -1.0, 1.0) : 0.0

// -----------------------------------------------------------------------------
// 8 · FACTOR 7 — higher-timeframe bias (derived from the chart timeframe)
// -----------------------------------------------------------------------------
// timeframe.from_seconds() is used rather than a hand-rolled converter because it
// is guaranteed to return a resolution request.security() accepts. A hand-rolled
// one can emit "3S" or "17W", which either error or snap to something else.
bool   htfOn  = htfMode != "Off" and wHtf > 0
string htfRes = htfMode == "Manual" ? htfManual : timeframe.from_seconds(timeframe.in_seconds(timeframe.period) * htfMult)
int    htfShift = htfStrict ? 1 : 0
// Guarded so that turning the higher timeframe off actually costs nothing — an
// unconditional call still consumes one of TradingView's 40 security slots.
float  htfRaw = htfOn ? request.security(syminfo.tickerid, htfRes, f_htfPacket(htfShift), lookahead = barmerge.lookahead_off) : na
float  sHtf   = htfOn ? f_clamp(nz(htfRaw), -1.0, 1.0) : 0.0

// -----------------------------------------------------------------------------
// 9 · CONFLUENCE SCORE
//     Weighted mean over the factors that are both enabled (weight > 0) and
//     available (volume present, HTF on). Σweights is recomputed every bar, so
//     disabling factors rescales rather than deadens the score.
// -----------------------------------------------------------------------------
float wSum = 0.0
float cSum = 0.0

if wTrend > 0
    wSum += wTrend
    cSum += wTrend * sTrend
if wDist > 0
    wSum += wDist
    cSum += wDist * sDist
if wMom > 0
    wSum += wMom
    cSum += wMom * sMom
if wAdx > 0
    wSum += wAdx
    cSum += wAdx * sAdx
if wStruct > 0
    wSum += wStruct
    cSum += wStruct * sStruct
if wFlow > 0 and volUsable
    wSum += wFlow
    cSum += wFlow * sFlow
if wHtf > 0 and htfOn
    wSum += wHtf
    cSum += wHtf * sHtf

float rawScore = wSum > 0 ? 100.0 * cSum / wSum : 0.0

// Over-extension guard: conviction falls once price is unusually far from value.
float stretch = math.abs(distATR)
float damp    = stretch > stretchMax ? math.max(0.35, 1.0 - (stretch - stretchMax) / (stretchMax * 2.0)) : 1.0
float score   = ta.ema(rawScore * damp, smoothLen)

// -----------------------------------------------------------------------------
// 10 · REGIME CLASSIFIER
//      Squeeze: lowerBB > lowerKC and upperBB < upperKC. Both reduce to the
//      same inequality, so it is computed once: bbDev < kcMult * ATR-ish range.
// -----------------------------------------------------------------------------
float basis   = ta.sma(close, sqzLen)
float bbDev   = bbMult * ta.stdev(close, sqzLen)
float kcRange = ta.sma(ta.tr(true), sqzLen)
bool  sqzOn   = bbDev < kcMult * kcRange

bool trending = nz(adxVal) >= adxFloor and math.abs(score) >= entryTh * 0.6
string regime = sqzOn ? "COMPRESSION" :
     trending and score > 0 ? "TREND UP" :
     trending and score < 0 ? "TREND DOWN" :
     volPct >= volHot ? "VOLATILE RANGE" : "RANGE"

bool trendUp    = regime == "TREND UP"
bool trendDn    = regime == "TREND DOWN"
bool ranging    = regime == "RANGE" or regime == "VOLATILE RANGE"
bool expansion  = sqzOn[1] and not sqzOn

var int barsInRegime = 0
barsInRegime := regime == regime[1] ? barsInRegime + 1 : 0

// -----------------------------------------------------------------------------
// 11 · PLAYBOOKS
// -----------------------------------------------------------------------------
// A · continuation — score pushes through the threshold
bool tfL = ta.crossover(score, entryTh)
bool tfS = ta.crossunder(score, -entryTh)
// B · reversion — score climbs back out of an extreme AFTER a stretched move
bool mrL = ta.crossover(score, -entryTh)  and ta.lowest(distATR, mrLook)  <= -mrStretch
bool mrS = ta.crossunder(score, entryTh)  and ta.highest(distATR, mrLook) >=  mrStretch
// C · breakout — the squeeze releases with the score already leaning
bool brL = expansion and score >  entryTh * 0.5 and close > basis
bool brS = expansion and score < -entryTh * 0.5 and close < basis

bool baseL = switch sigMode
    "Trend-following only" => tfL
    "Mean-reversion only"  => mrL and ranging
    "Breakout only"        => brL
    => brL or ((trendUp or trendDn) ? tfL : ranging ? mrL : false)

bool baseS = switch sigMode
    "Trend-following only" => tfS
    "Mean-reversion only"  => mrS and ranging
    "Breakout only"        => brS
    => brS or ((trendUp or trendDn) ? tfS : ranging ? mrS : false)

// Gates
bool barOk     = closedOnly ? barstate.isconfirmed : true
bool structOkL = not needStruct or structEff >= 0
bool structOkS = not needStruct or structEff <= 0
bool htfOkL    = not needHtf or not htfOn or sHtf > 0
bool htfOkS    = not needHtf or not htfOn or sHtf < 0

bool candL = baseL and structOkL and htfOkL and barOk
bool candS = baseS and structOkS and htfOkS and barOk

var int lastSigBar = -100000
bool cooled  = (bar_index - lastSigBar) > cooldown
bool longSig  = candL and not candS and cooled
bool shortSig = candS and not candL and cooled
if longSig or shortSig
    lastSigBar := bar_index

// -----------------------------------------------------------------------------
// 12 · ENTRY TRIGGER + RISK MODEL
//      A signal says the evidence has lined up. It does not say "buy here".
//
//      In CONFIRM mode (default) a signal only ARMS a setup, at the signal bar's
//      high for a long or its low for a short. The entry moment is the later bar
//      on which price actually takes that level out — that bar, and that price,
//      are what the engine reports as the entry. A signal price never confirms
//      simply lapses after `armExpiry` bars, or is voided early if the score
//      collapses back into the stand-aside band while waiting.
//
//      In IMMEDIATE mode the signal bar is the entry moment, as before.
//
//      Everything downstream — stance, stop, targets, R, size — is built from the
//      TRIGGER price, not the signal bar's close, so the numbers describe the
//      trade you would actually have.
// -----------------------------------------------------------------------------
float swingLo = ta.lowest(low, swingLB)
float swingHi = ta.highest(high, swingLB)

float stopL = stopMode == "Pure ATR"   ? close - atrStop * atr :
     stopMode == "Chandelier"          ? swingHi - atrStop * atr :
     swingLo - 0.5 * atrStop * atr
float stopS = stopMode == "Pure ATR"   ? close + atrStop * atr :
     stopMode == "Chandelier"          ? swingLo + atrStop * atr :
     swingHi + 0.5 * atrStop * atr

// Never let a structural stop land on the wrong side of price.
stopL := stopL >= close ? close - atrStop * atr : stopL
stopS := stopS <= close ? close + atrStop * atr : stopS

// --- arming ---------------------------------------------------------------
bool confirmMode = entryMode == "Confirm — break of the signal bar's extreme"

var int    armDir   = 0
var float  armLevel = na
var float  armStop  = na
var int    armBar   = na
var string armState = "idle"

if longSig
    armDir   := 1
    armLevel := confirmMode ? high + syminfo.mintick : close
    armStop  := stopL
    armBar   := bar_index
if shortSig
    armDir   := -1
    armLevel := confirmMode ? low - syminfo.mintick : close
    armStop  := stopS
    armBar   := bar_index

int armAge = na(armBar) ? na : bar_index - armBar

// Confirm mode fires on a LATER bar that trades through the armed level.
// Immediate mode fires on the signal bar itself (you act at the next open).
bool fireL = armDir > 0 and (confirmMode ? (armAge > 0 and high >= armLevel) : armAge == 0)
bool fireS = armDir < 0 and (confirmMode ? (armAge > 0 and low  <= armLevel) : armAge == 0)

bool armWaiting = armDir != 0 and confirmMode and not fireL and not fireS and armAge > 0
bool armVoided  = armWaiting and math.abs(score) < exitTh
bool armExpired = armWaiting and not armVoided and armAge > armExpiry

if longSig or shortSig
    armState := confirmMode ? "armed" : "entry"
else if fireL or fireS
    armState := "entry"
else if armVoided
    armState := "voided · score faded"
else if armExpired
    armState := "lapsed · never confirmed"

if fireL or fireS or armVoided or armExpired
    armDir := 0

// Engine stance: what the tool thinks you should be doing right now
var int stance = 0
if fireL
    stance := 1
if fireS
    stance := -1
bool standDown = stance != 0 and math.abs(score) < exitTh
if standDown
    stance := 0

var float eEntry = na
var float eStop  = na
var float eT1    = na
var float eT2    = na
var float eT3    = na
var int   eDir   = 0

if fireL
    eEntry := confirmMode ? armLevel : close
    eStop  := na(armStop) or armStop >= eEntry ? eEntry - atrStop * atr : armStop
    eDir   := 1
    float rUnit = eEntry - eStop
    eT1 := eEntry + rt1 * rUnit
    eT2 := eEntry + rt2 * rUnit
    eT3 := eEntry + rt3 * rUnit
if fireS
    eEntry := confirmMode ? armLevel : close
    eStop  := na(armStop) or armStop <= eEntry ? eEntry + atrStop * atr : armStop
    eDir   := -1
    float rUnitS = eStop - eEntry
    eT1 := eEntry - rt1 * rUnitS
    eT2 := eEntry - rt2 * rUnitS
    eT3 := eEntry - rt3 * rUnitS

// -----------------------------------------------------------------------------
// 12b · SETUP INVALIDATION
//      A setup ends for one of three reasons, and the panel must say which.
//      Price trading through the stop is the one the score cannot detect: it can
//      swing from +40 to -40 without ever crossing the stand-aside band.
// -----------------------------------------------------------------------------
// `not (longSig or shortSig)` keeps a setup from being invalidated by the very bar
// that created it: with a pure-ATR stop, any bar wider than atrStop x ATR would
// otherwise trip its own stop test the instant it fired.
bool freshSig     = fireL or fireS
bool stopBreached = stance != 0 and not freshSig and not na(eStop) and (stance > 0 ? low  <= eStop : high >= eStop)
bool targetDone   = stance != 0 and not freshSig and not na(eT3)  and (stance > 0 ? high >= eT3   : low  <= eT3)

if stopBreached or targetDone
    stance := 0

var string setupState = "none"
if longSig or shortSig
    setupState := "live"
else if stopBreached
    setupState := "stopped out"
else if targetDone
    setupState := "target 3 reached"
else if standDown
    setupState := "score faded"

float riskPerUnit = na(eEntry) ? na : math.abs(eEntry - eStop)
float riskATR     = na(riskPerUnit) or atr <= 0 ? na : riskPerUnit / atr
// <<<<< ENGINE BLOCK END <<<<<
// -----------------------------------------------------------------------------
// 13 · EXECUTION
// -----------------------------------------------------------------------------
grpBT = "⑧ Backtest execution"
tradeDir   = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpBT)
sizeMode   = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "Percent of equity", "Fixed contracts"], group = grpBT, tooltip = "Risk % of equity sizes every trade off the distance to its own stop, which is what makes one setting behave the same on any instrument.")
fixedQty   = input.float(1.0, "Fixed contracts", minval = 0.000001, group = grpBT)
eqPct      = input.float(10.0, "Percent of equity", minval = 0.1, maxval = 100, group = grpBT)
maxNotPct  = input.float(100.0, "Max position notional (% of equity)", minval = 1, maxval = 1000, step = 5, group = grpBT, tooltip = "Hard cap on size. Without it a very tight stop asks risk-based sizing for many times equity — the emulator fills it, and the equity curve then reflects leverage no real account could carry.")
useTargets = input.bool(true, "Scale out in thirds at T1 / T2 / T3", group = grpBT)
useTrail   = input.bool(true, "Trail the remainder (Chandelier)", group = grpBT)
trailMult  = input.float(2.5, "Trail ATR multiple", minval = 0.5, step = 0.1, group = grpBT)
beAtR      = input.float(1.0, "Move stop to breakeven at (R)  ·  0 = off", minval = 0, step = 0.25, group = grpBT)
flatOnFade = input.bool(true, "Close when |score| drops below stand-aside level", group = grpBT)
allowFlip  = input.bool(true, "Reverse on an opposite signal", group = grpBT)
fromDate   = input.time(timestamp("1 Jan 2015 00:00 +0000"), "Backtest from", group = grpBT)
toDate     = input.time(timestamp("1 Jan 2100 00:00 +0000"), "Backtest to", group = grpBT)

// Visual inputs live HERE, not in the shared engine, because the two scripts need
// different defaults. Running the indicator and the strategy on one chart with the
// same defaults draws two adaptive MAs, two sets of structure lines, two sets of
// arrows — and two dashboard panels stacked on one screen. So the strategy ships
// with its chart layers AND its panel off: the indicator is the display, the
// strategy is the execution. Everything the strategy alone knows (position, P&L,
// drawdown) is already in TradingView's Strategy Tester below the chart.
// Running the strategy on its own? Turn these back on.
grpVis = "⑦ Visuals  ·  off by default — the indicator owns the chart"
panelMode  = input.string("Compact · essentials only", "Panel detail", options = ["Full · every factor", "Compact · essentials only"], group = grpVis)
showPanel  = input.bool(false, "Dashboard panel", group = grpVis, tooltip = "OFF by default. The indicator already draws this panel, and two of them on one screen is clutter rather than information. Turn it on only if you run the strategy without the indicator.")
tblPos     = input.string("Bottom right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpVis, tooltip = "Opposite corner from the indicator, so that if you do enable both they still do not overlap.")
darkUI     = input.bool(true, "Dark panel", group = grpVis)
showMA     = input.bool(false, "Adaptive MA", group = grpVis, tooltip = "Leave off when the indicator is also on this chart — it already draws this.")
showRibbon = input.bool(false, "Volatility ribbon", group = grpVis, tooltip = "Leave off when the indicator is also on this chart.")
colorBars  = input.bool(false, "Colour bars by score", group = grpVis, tooltip = "Leave off when the indicator is also on this chart.")
showStruct = input.bool(false, "Structure breaks (BOS / CHoCH)", group = grpVis, tooltip = "Leave off when the indicator is also on this chart.")
showSig    = input.bool(false, "Signal + entry markers", group = grpVis, tooltip = "Leave off when the indicator is also on this chart. TradingView draws the strategy's own fills regardless.")
showBg     = input.bool(false, "Shade compression regime", group = grpVis, tooltip = "Leave off when the indicator is also on this chart.")
showRisk   = input.bool(true, "Live stop / target of the OPEN trade", group = grpVis, tooltip = "Safe to leave on — this tracks the live position, which the indicator cannot know about.")
cBull      = input.color(#089981, "Bull", inline = "col", group = grpVis)
cBear      = input.color(#f23645, "Bear", inline = "col", group = grpVis)
cNeut      = input.color(#787b86, "Neutral", inline = "col", group = grpVis)

string panelTitle = "REGIME ENGINE · STRATEGY"

// Presentation figures for the shared panel, computed from REAL strategy equity so
// the panel can never advertise a size the script does not actually trade.
float  sizeUnits = na(riskPerUnit) or riskPerUnit <= 0 ? na : strategy.equity * riskPct / 100.0 / riskPerUnit
string sizeLabel = "Size @ " + str.tostring(riskPct, "#.##") + "% of equity"
string sizeRisk  = na(riskPerUnit) ? "—" : str.tostring(strategy.equity * riskPct / 100.0, "#.##")

// Position size. Risk-based sizing is the default because it is the only mode
// whose meaning does not change when you switch instrument.
f_qty(entryPx, stopPx) =>
    float q = na
    if sizeMode == "Fixed contracts"
        q := fixedQty
    else if sizeMode == "Percent of equity"
        q := entryPx > 0 ? strategy.equity * eqPct / 100.0 / entryPx : na
    else
        float rpu = math.abs(entryPx - stopPx)
        q := rpu > 0 ? strategy.equity * riskPct / 100.0 / rpu : na
    float cap = entryPx > 0 ? strategy.equity * maxNotPct / 100.0 / entryPx : na
    na(q) or na(cap) ? q : math.min(q, cap)

bool inWindow    = time >= fromDate and time <= toDate
bool allowL      = tradeDir != "Short only"
bool allowS      = tradeDir != "Long only"
bool tradableBar = not na(atr) and atr > 0

// In Confirm mode the order is a STOP order resting at the armed level, placed on
// the signal bar. That is the same event the indicator's ENTRY marker shows, and it
// is more realistic than a market order: the backtest only takes the trade if price
// genuinely traded through the level.
bool armL = longSig  and allowL and inWindow and tradableBar
bool armS = shortSig and allowS and inWindow and tradableBar

bool openL = armL and (strategy.position_size == 0 or (strategy.position_size < 0 and allowFlip))
bool openS = armS and (strategy.position_size == 0 or (strategy.position_size > 0 and allowFlip))

float refEntryL = confirmMode ? armLevel : close
float refEntryS = confirmMode ? armLevel : close
float qL = nz(f_qty(refEntryL, stopL), 0.0)
float qS = nz(f_qty(refEntryS, stopS), 0.0)

// Live trade state. rUnit0 is frozen at the fill so that "R" keeps meaning the risk
// actually taken, even after the stop is trailed or moved to breakeven.
var float curEntry = na
var float curStop  = na
var float rUnit0   = na
var float posQty   = na
var int   curDir   = 0
var bool  tookT1   = false
var bool  tookT2   = false
var float prevPos  = 0.0

// --- place the order --------------------------------------------------------
// The protective exit MUST be submitted in the same block as the entry. Gating it
// on `strategy.position_size != 0` means the exit is only placed after the fill is
// visible, leaving the position naked for its whole first bar.
if openL and qL > 0
    if confirmMode
        strategy.entry("L", strategy.long, qty = qL, stop = armLevel, comment = "score " + str.tostring(score, "#"))
    else
        strategy.entry("L", strategy.long, qty = qL, comment = "score " + str.tostring(score, "#"))
    curDir   := 1
    curEntry := refEntryL
    curStop  := stopL
    rUnit0   := refEntryL - stopL
    posQty   := qL
    tookT1   := false
    tookT2   := false
if openS and qS > 0
    if confirmMode
        strategy.entry("S", strategy.short, qty = qS, stop = armLevel, comment = "score " + str.tostring(score, "#"))
    else
        strategy.entry("S", strategy.short, qty = qS, comment = "score " + str.tostring(score, "#"))
    curDir   := -1
    curEntry := refEntryS
    curStop  := stopS
    rUnit0   := stopS - refEntryS
    posQty   := qS
    tookT1   := false
    tookT2   := false

// A resting stop-entry that the engine has given up on must be cancelled, or it
// would sit on the book long after the setup stopped being valid.
if armVoided or armExpired
    strategy.cancel("L")
    strategy.cancel("S")
    if strategy.position_size == 0
        curDir := 0

// --- reconcile with the real fill ------------------------------------------
bool justOpenedL = strategy.position_size > 0 and prevPos <= 0
bool justOpenedS = strategy.position_size < 0 and prevPos >= 0
bool justFlat    = strategy.position_size == 0 and prevPos != 0

if justOpenedL
    curDir   := 1
    curEntry := strategy.position_avg_price
    curStop  := na(curStop) or curStop >= curEntry ? curEntry - atrStop * atr : curStop
    rUnit0   := curEntry - curStop
    posQty   := math.abs(strategy.position_size)
if justOpenedS
    curDir   := -1
    curEntry := strategy.position_avg_price
    curStop  := na(curStop) or curStop <= curEntry ? curEntry + atrStop * atr : curStop
    rUnit0   := curStop - curEntry
    posQty   := math.abs(strategy.position_size)
if justFlat
    curDir   := 0
    curEntry := na
    curStop  := na
    rUnit0   := na
    posQty   := na

// --- breakeven and trail ----------------------------------------------------
// Gated on an OPEN position: with a resting stop-entry, curDir is already set while
// nothing is filled, and trailing a stop for a trade that does not exist yet would
// move the protective level away from where the entry was actually planned.
//
// swingHi / swingLo come from the engine, where ta.highest / ta.lowest are evaluated
// on EVERY bar. Calling those functions here, inside a conditional, would advance
// their windows only on bars where a position is open.
//
// Both updates are strictly monotonic: a stop is never loosened.
if curDir > 0 and rUnit0 > 0 and strategy.position_size > 0
    if beAtR > 0 and high >= curEntry + beAtR * rUnit0
        curStop := math.max(curStop, curEntry)
    if useTrail
        curStop := math.max(curStop, swingHi - trailMult * atr)
if curDir < 0 and rUnit0 > 0 and strategy.position_size < 0
    if beAtR > 0 and low <= curEntry - beAtR * rUnit0
        curStop := math.min(curStop, curEntry)
    if useTrail
        curStop := math.min(curStop, swingLo + trailMult * atr)

float tg1 = curDir == 0 or na(rUnit0) ? na : curDir > 0 ? curEntry + rt1 * rUnit0 : curEntry - rt1 * rUnit0
float tg2 = curDir == 0 or na(rUnit0) ? na : curDir > 0 ? curEntry + rt2 * rUnit0 : curEntry - rt2 * rUnit0
float tg3 = curDir == 0 or na(rUnit0) ? na : curDir > 0 ? curEntry + rt3 * rUnit0 : curEntry - rt3 * rUnit0

// --- target latches ---------------------------------------------------------
// Re-issuing a filled exit id re-creates the order. With a limit already behind the
// market it fills again at the next open, shedding another slice every bar until the
// position is gone. These latches stop each leg being submitted once it has traded.
if curDir > 0 and strategy.position_size > 0
    if high >= tg1
        tookT1 := true
    if high >= tg2
        tookT2 := true
if curDir < 0 and strategy.position_size < 0
    if low <= tg1
        tookT1 := true
    if low <= tg2
        tookT2 := true

// --- protective orders ------------------------------------------------------
// Absolute thirds, not qty_percent. qty_percent is a share of the position, so
// 33 / 50 / remainder is 33/50/17 of the original size, not equal thirds.
float leg = na(posQty) ? na : posQty / 3.0

if curDir > 0 and not na(curStop)
    if useTargets and not na(leg)
        if not tookT1
            strategy.exit("L1", "L", qty = leg, stop = curStop, limit = tg1, comment_profit = "T1", comment_loss = "stop")
        if not tookT2
            strategy.exit("L2", "L", qty = leg, stop = curStop, limit = tg2, comment_profit = "T2", comment_loss = "stop")
        strategy.exit("L3", "L", stop = curStop, limit = tg3, comment_profit = "T3", comment_loss = "stop")
    else
        strategy.exit("LX", "L", stop = curStop, comment_loss = "stop")
if curDir < 0 and not na(curStop)
    if useTargets and not na(leg)
        if not tookT1
            strategy.exit("S1", "S", qty = leg, stop = curStop, limit = tg1, comment_profit = "T1", comment_loss = "stop")
        if not tookT2
            strategy.exit("S2", "S", qty = leg, stop = curStop, limit = tg2, comment_profit = "T2", comment_loss = "stop")
        strategy.exit("S3", "S", stop = curStop, limit = tg3, comment_profit = "T3", comment_loss = "stop")
    else
        strategy.exit("SX", "S", stop = curStop, comment_loss = "stop")

// --- discretionary flats ----------------------------------------------------
// A close beyond the stop while still in the position (a gap through it on the very
// first bar) is exited at market. The stop is never moved to meet price.
if strategy.position_size > 0 and curDir > 0 and not na(curStop) and close < curStop
    strategy.close("L", comment = "stop breached")
if strategy.position_size < 0 and curDir < 0 and not na(curStop) and close > curStop
    strategy.close("S", comment = "stop breached")
if flatOnFade and strategy.position_size != 0 and math.abs(score) < exitTh
    strategy.close_all(comment = "score faded")
if strategy.position_size != 0 and not inWindow
    strategy.close_all(comment = "out of window")

prevPos := strategy.position_size

// -----------------------------------------------------------------------------
// 14 · VISUALS  (all chart layers default OFF — see grpVis above)
// -----------------------------------------------------------------------------
color trendCol = score > 15 ? cBull : score < -15 ? cBear : cNeut
float kamaSig  = ta.ema(kama, math.max(2, erLen / 2))

pMa  = plot(showMA ? kama : na, "Adaptive MA", color = trendCol, linewidth = 2)
pSig = plot(showRibbon ? kamaSig : na, "MA envelope", color = color.new(trendCol, 55), linewidth = 1)
fill(pMa, pSig, color = color.new(trendCol, 88), title = "Trend envelope")
barcolor(colorBars ? (score > entryTh ? cBull : score < -entryTh ? cBear : na) : na, title = "Score-coloured bars")

bgcolor(showBg and sqzOn ? color.new(cNeut, 90) : na, title = "Compression")

plot(showStruct ? structLvl : na, "Active structure level", color = color.new(structDir > 0 ? cBull : cBear, 35), style = plot.style_linebr, linewidth = 1)

if showStruct and (bosUp or bosDn)
    int   fromBar = bosUp ? nz(lastPHbar, bar_index - pvtLen) : nz(lastPLbar, bar_index - pvtLen)
    float lvl     = bosUp ? lastPH : lastPL
    bool  isChoch = bosUp ? chochUp : chochDn
    line.new(fromBar, lvl, bar_index, lvl, color = color.new(bosUp ? cBull : cBear, 25), style = isChoch ? line.style_solid : line.style_dotted, width = isChoch ? 2 : 1)

plot(showSig and armDir != 0 ? armLevel : na, "Armed trigger level", color = color.new(armDir > 0 ? cBull : cBear, 10), style = plot.style_linebr, linewidth = 2)
plotshape(showSig and longSig,  "Signal · long armed",  shape.triangleup,   location.belowbar, color = color.new(cBull, 45), size = size.tiny)
plotshape(showSig and shortSig, "Signal · short armed", shape.triangledown, location.abovebar, color = color.new(cBear, 45), size = size.tiny)
plotshape(showSig and fireL, "ENTRY long",  shape.labelup,   location.belowbar, color = cBull, textcolor = color.white, text = "ENTRY", size = size.small)
plotshape(showSig and fireS, "ENTRY short", shape.labeldown, location.abovebar, color = cBear, textcolor = color.white, text = "ENTRY", size = size.small)

// The live risk envelope of the OPEN trade — the indicator does not draw this, so
// it stays on by default even in companion mode.
plot(showRisk and curDir != 0 and strategy.position_size != 0 ? curStop : na, "Active stop", color = cBear, style = plot.style_linebr, linewidth = 1)
plot(showRisk and strategy.position_size != 0 and useTargets ? tg1 : na, "Target 1", color = color.new(cBull, 40), style = plot.style_linebr)
plot(showRisk and strategy.position_size != 0 and useTargets ? tg2 : na, "Target 2", color = color.new(cBull, 55), style = plot.style_linebr)
plot(showRisk and strategy.position_size != 0 and useTargets ? tg3 : na, "Target 3", color = color.new(cBull, 70), style = plot.style_linebr)

plot(score,    "Confluence score", display = display.data_window)
plot(rawScore, "Raw score (pre-damp)", display = display.data_window)
plot(sTrend,   "F1 trend slope", display = display.data_window)
plot(sDist,    "F2 displacement", display = display.data_window)
plot(sMom,     "F3 momentum", display = display.data_window)
plot(sAdx,     "F4 directional", display = display.data_window)
plot(sStruct,  "F5 structure", display = display.data_window)
plot(sFlow,    "F6 volume flow", display = display.data_window)
plot(sHtf,     "F7 HTF bias", display = display.data_window)
plot(atrPct,   "ATR %", display = display.data_window)
plot(volPct,   "Volatility percentile", display = display.data_window)
plot(slopeATR, "Slope (ATR)", display = display.data_window)
plot(distATR,  "Displacement (ATR)", display = display.data_window)

// -----------------------------------------------------------------------------
// 15 · DASHBOARD PANEL
//      Nothing in the score is a black box: every factor shows its raw reading, its
//      normalised bias, its weight and the exact points it contributed on this bar,
//      and the PTS column sums to the score. Compact mode drops the breakdown and
//      the context block for screens that cannot spare the height.
// -----------------------------------------------------------------------------
tablePos = tblPos == "Top left" ? position.top_left :
     tblPos == "Bottom right"   ? position.bottom_right :
     tblPos == "Bottom left"    ? position.bottom_left :
     tblPos == "Middle right"   ? position.middle_right : position.top_right

color cPanel = darkUI ? color.new(#131722, 12) : color.new(#ffffff, 8)
color cHdr   = darkUI ? color.new(#2a2e39, 8)  : color.new(#e0e3eb, 8)
color cTxt   = darkUI ? #d1d4dc : #131722
color cDim   = darkUI ? #787b86 : #5d606b

var table dash = table.new(tablePos, 5, 28, border_width = 1, frame_width = 1, frame_color = cHdr)

f_row(t, r, c0, c1, c2, c3, c4, col, bg) =>
    table.cell(t, 0, r, c0, text_color = cDim, bgcolor = bg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, c1, text_color = col, bgcolor = bg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, c2, text_color = col, bgcolor = bg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 3, r, c3, text_color = cDim, bgcolor = bg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, c4, text_color = col, bgcolor = bg, text_size = size.small, text_halign = text.align_right)

if showPanel and barstate.islast
    // Cleared every render so switching between Full and Compact cannot leave stale
    // rows from the taller layout behind.
    table.clear(dash, 0, 0, 4, 27)

    bool  full    = panelMode == "Full · every factor"
    color cScore  = score > 15 ? cBull : score < -15 ? cBear : cNeut
    color cRegime = trendUp ? cBull : trendDn ? cBear : regime == "COMPRESSION" ? color.new(#f7a600, 0) : cNeut
    int   r       = 0

    f_row(dash, r, "◆ " + panelTitle, syminfo.ticker, "", timeframe.period, "", cTxt, cHdr)
    r += 1
    f_row(dash, r, "Confluence score", str.tostring(score, "#.#"), f_gauge(score / 100.0), "±100", str.tostring(wSum, "#.##") + "w", cScore, cPanel)
    r += 1
    f_row(dash, r, "Regime", regime, "", "bars", str.tostring(barsInRegime), cRegime, cPanel)
    r += 1
    f_row(dash, r, "Playbook", sigMode == "Auto (regime aware)" ? ((trendUp or trendDn) ? "continuation" : ranging ? "reversion" : "await expansion") : sigMode, "", "", "", cTxt, cPanel)
    r += 1

    if full
        f_row(dash, r, "FACTOR", "READING", "BIAS", "W", "PTS", cTxt, cHdr)
        r += 1

        array<string> fName = array.from("1 Trend slope", "2 Displacement", "3 Momentum (RSI)", "4 Directional", "5 Structure", "6 Volume flow", "7 HTF " + htfRes)
        array<string> fRead = array.from(
             str.tostring(slopeATR, "#.##") + " atr",
             str.tostring(distATR, "#.##") + " atr",
             str.tostring(rsi, "#.#"),
             str.tostring(adxVal, "#.#") + " adx",
             structEff > 0 ? "bullish" : structEff < 0 ? "bearish" : structDir != 0 ? "expired" : "none",
             volUsable ? str.tostring(mfi, "#.#") : "n/a",
             htfOn ? str.tostring(sHtf, "#.##") : "off")
        array<float>  fBias = array.from(sTrend, sDist, sMom, sAdx, sStruct, sFlow, sHtf)
        array<float>  fW    = array.from(wTrend, wDist, wMom, wAdx, wStruct, wFlow, wHtf)
        array<bool>   fOk   = array.from(true, true, true, true, true, volUsable, htfOn)

        for i = 0 to 6
            float w   = array.get(fW, i)
            bool  on  = w > 0 and array.get(fOk, i)
            float b   = array.get(fBias, i)
            float pts = on and wSum > 0 ? 100.0 * w * b / wSum : 0.0
            color rc  = not on ? cDim : b > 0.05 ? cBull : b < -0.05 ? cBear : cNeut
            f_row(dash, r + i, array.get(fName, i), on ? array.get(fRead, i) : "off",
                 on ? f_gauge(b) : "—", str.tostring(w, "#.##"), on ? str.tostring(pts, "#.#") : "—", rc, cPanel)
        r += 7

        f_row(dash, r, "CONTEXT", "", "", "", "", cTxt, cHdr)
        r += 1
        f_row(dash, r, "ATR (volatility ruler)", str.tostring(atrPct, "#.##") + "%", f_gauge(volPct / 50.0 - 1.0), "pct", str.tostring(volPct, "#"), cTxt, cPanel)
        r += 1
        f_row(dash, r, "Squeeze", sqzOn ? "ON — coiled" : "off", "", "", "", sqzOn ? color.new(#f7a600, 0) : cDim, cPanel)
        r += 1
        f_row(dash, r, "Over-extension damp", str.tostring(damp * 100.0, "#") + "%", "", "stretch", str.tostring(stretch, "#.##"), damp < 1 ? color.new(#f7a600, 0) : cDim, cPanel)
        r += 1
        f_row(dash, r, "Volume feed", volUsable ? "usable" : "absent → factor dropped", "", "", "", volUsable ? cTxt : cDim, cPanel)
        r += 1

    f_row(dash, r, "ACTIVE SETUP", "", "", "", "", cTxt, cHdr)
    r += 1
    f_row(dash, r, "Entry trigger",
         armDir != 0 ? str.tostring(armLevel, format.mintick) : armState == "entry" ? "fired" : "—",
         armDir != 0 ? (armDir > 0 ? "break above" : "break below") : "",
         armDir != 0 and confirmMode ? "expires" : "",
         armDir != 0 and confirmMode ? str.tostring(math.max(0, armExpiry - armAge)) + "b" : "",
         armDir > 0 ? cBull : armDir < 0 ? cBear : armState == "entry" ? cTxt : cDim, cPanel)
    r += 1
    f_row(dash, r, "Stance", stance > 0 ? "▲ LONG" : stance < 0 ? "▼ SHORT" : "flat", setupState, "since", na(eEntry) ? "—" : str.tostring(bar_index - lastSigBar) + "b", stance > 0 ? cBull : stance < 0 ? cBear : cDim, cPanel)
    r += 1
    f_row(dash, r, "Entry", na(eEntry) ? "—" : str.tostring(eEntry, format.mintick), "", "", "", cTxt, cPanel)
    r += 1
    f_row(dash, r, "Stop", na(eStop) ? "—" : str.tostring(eStop, format.mintick), "", "atr", na(riskATR) ? "—" : str.tostring(riskATR, "#.##"), cBear, cPanel)
    r += 1
    f_row(dash, r, "Targets 1 / 2 / 3", na(eT1) ? "—" : str.tostring(eT1, format.mintick) + " / " + str.tostring(eT2, format.mintick) + " / " + str.tostring(eT3, format.mintick), "", "R", str.tostring(rt1, "#.#") + "/" + str.tostring(rt2, "#.#") + "/" + str.tostring(rt3, "#.#"), cBull, cPanel)
    r += 1
    f_row(dash, r, sizeLabel, na(sizeUnits) ? "—" : str.tostring(sizeUnits, "#.####") + " units", "", "risk", sizeRisk, cTxt, cPanel)
    r += 1
    f_row(dash, r, closedOnly ? "Closed-bar signals" : "Intrabar signals (mutable)", htfStrict ? "HTF: closed bar" : "HTF: live bar", "", "", "", cDim, cPanel)
    r += 1

    f_row(dash, r, "Position", strategy.position_size > 0 ? "▲ LONG " + str.tostring(strategy.position_size, "#.####") : strategy.position_size < 0 ? "▼ SHORT " + str.tostring(math.abs(strategy.position_size), "#.####") : "flat", "", "avg", strategy.position_size != 0 ? str.tostring(strategy.position_avg_price, format.mintick) : "—", strategy.position_size > 0 ? cBull : strategy.position_size < 0 ? cBear : cDim, cPanel)
    r += 1
    f_row(dash, r, "Open P&L", str.tostring(strategy.openprofit, "#.##"), "", "equity", str.tostring(strategy.equity, "#.##"), strategy.openprofit > 0 ? cBull : strategy.openprofit < 0 ? cBear : cDim, cPanel)

// -----------------------------------------------------------------------------
// 16 · ALERTS
// -----------------------------------------------------------------------------
// alertcondition() is an indicator-only function — a strategy uses alert() plus
// TradingView's own order-fill alerts.
if fireL or fireS
    alert((fireL ? "FURE-S ENTRY LONG " : "FURE-S ENTRY SHORT ") + syminfo.ticker + " " + timeframe.period +
         " | score " + str.tostring(score, "#.#") +
         " | regime " + regime +
         " | entry " + str.tostring(eEntry, format.mintick) +
         " | stop " + str.tostring(eStop, format.mintick), alert.freq_once_per_bar_close)
